rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 暗証番号を入れた携帯（members に登録された人）だけが読み書きできる
    function member() {
      return request.auth != null && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    // 暗証番号の本体：だれも読めない（ルールの中でだけ比べる）
    match /secret/{d} { allow read, write: if false; }
    // 番号が合っていたら、その携帯を登録できる
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.pin == get(/databases/$(database)/documents/secret/pin).data.pin;
      allow update, delete: if false;
    }
    // 予定を入れられる携帯（editors に登録された人＝西崎・原田）
    function editor() {
      return request.auth != null && exists(/databases/$(database)/documents/editors/$(request.auth.uid));
    }
    // 編集用の番号（secret/pin の editpin）が合っていたら、その携帯を編集する人として登録できる
    match /editors/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.pin == get(/databases/$(database)/documents/secret/pin).data.editpin
        && request.resource.data.name in ["西崎剣", "原田弓子"];
      allow update, delete: if false;
    }
    // 西崎さんの携帯（editors に西崎剣として登録）
    function boss() {
      return editor() && get(/databases/$(database)/documents/editors/$(request.auth.uid)).data.name == "西崎剣";
    }
    // 西崎さんだけのメモ（だれもえらばない予定）：西崎さんだけが読み書きできる
    match /memos/{id} { allow read, write: if boss(); }
    // 予定表：社員は見るだけ。入れる・直す・消すのは編集する人だけ
    match /events/{id} { allow read: if member(); allow write: if editor(); }
    match /items/{id} { allow read, write: if member(); }
    match /sites/{id} { allow read, write: if member(); }
    // 現場に頼んだ材料：社員も頼める（足すだけ）。直す・消す（在庫から出した印）は編集する人だけ
    match /orders/{id} { allow read, create: if member(); allow update, delete: if editor(); }
    // 社員の顔写真（現場一覧のメーターを走るサプライズ用）：見るのは社員、入れる・消すのは編集する人だけ
    match /faces/{name} { allow read: if member(); allow write: if editor(); }
    // 現場の写真（材料置き場など）：社員だれでも足す・書きかえる・取り替える・消すができる（2026/10/29 ユーザー）
    match /photos/{id} { allow read, write: if member(); }
    match /photoFull/{id} { allow read, write: if member(); }
    // 材料屋さんの請求書から取った納品（金額は入れない）：見るのは社員。足すのは暗証番号を入れた携帯（請求書を読み込むとき）、直す・消すのは編集する人だけ
    match /deliveries/{id} { allow read, create: if member(); allow update, delete: if editor(); }
    // 注文の通知を受け取る携帯の登録：西崎さんの携帯だけが入れられる（読むのは通知を送る仕組みだけ）
    match /pushTokens/{id} { allow create, update, delete: if boss(); allow read: if false; }
    // 工程表の写真（社員が送る）：送る・見るのは社員だれでも。保存済みにする・消すのは編集する人（西崎・原田）だけ（2026/10/31）
    match /koutei/{id} { allow read, create: if member(); allow update, delete: if editor(); }
    match /kouteiFull/{id} { allow read, create: if member(); allow update, delete: if editor(); }
    // 履歴は足すだけ（直したり消したりはできない）
    match /logs/{id} { allow read, create: if member(); allow update, delete: if false; }
  }
}
